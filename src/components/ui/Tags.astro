---
export interface Props {
  tags: string[];
  class?: string;
  tagClass?: string;
}

const { tags, class: className = "text-sm", tagClass } = Astro.props;
const defaultTagClass =
  tagClass ||
  "inline-block bg-muted/50 text-muted-foreground px-3 py-1 rounded-full border border-border";
---

{
  tags && Array.isArray(tags) && (
    <ul class:list={["flex flex-wrap gap-2", className]}>
      {tags.map((tag) => (
        <li class="inline-block relative">
          <span class={defaultTagClass}>#{tag}</span>
        </li>
      ))}
    </ul>
  )
}
